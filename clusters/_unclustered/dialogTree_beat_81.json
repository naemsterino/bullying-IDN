                                                                                                                    {
                                                                                                                      "id": "choice_1792488474035",
                                                                                                                      "target": "beat_64_copymva1z9h31_copymva3d1m11_copymva4fbgc1",
                                                                                                                      "text": "Player response...",
                                                                                                                      "visible": true
                                                                                                                    }
                                                                                                                  ],
                                                                                                                  "id": "node_1792420577008",
                                                                                                                  "speaker": "Stan",
                                                                                                                  "text": "Billie, your apology does not matter if you continue to behave the same way, and worse of it if it happens on the very same day. Otherwise it's not a real apology!\n"
                                                                                                                },
                                                                                                                "id": "continue_1792420577008",
                                                                                                                "text": ""
                                                                                                              }
                                                                                                            ],
                                                                                                            "id": "node_1792420310410",
                                                                                                            "speaker": "Billie",
                                                                                                            "text": "For what? Plus I already apologized to them earlier. I told them I didn't mean to! Why should I apologize to them again!"
                                                                                                          },
                                                                                                          "id": "continue_1792420310410",
                                                                                                          "text": ""
                                                                                                        }
                                                                                                      ],
                                                                                                      "id": "node_1792420260968",
                                                                                                      "speaker": "Stan",
                                                                                                      "text": "Instead of screaming and projecting, maybe you should  apologize to Vic!"
                                                                                                    },
                                                                                                    "id": "continue_1792420260968",
                                                                                                    "text": ""
                                                                                                  }
                                                                                                ],
                                                                                                "id": "node_1792419396793",
                                                                                                "speaker": "Billie",
                                                                                                "text": "*Screeches*. WHAT DO YOU WANT FROM ME? YOU ALWAYS DO THIS! YOU'RE ALWAYS BLAMING ME FOR EVERYTHING! I JUST WANNA HAVE A NICE DAY PLAYING SOME GAMES  ON MY PHONE. CAN YOU JUST LET ME BE!"
                                                                                              },
                                                                                              "id": "continue_1792419396793",
                                                                                              "text": ""
                                                                                            }
                                                                                          ],
                                                                                          "id": "node_1792419247667",
                                                                                          "speaker": "Stan",
                                                                                          "text": "Real classy Billie! Now I'm Mr. Boring, aren't I? Also why are you even bringing up unhinged death threats. Are you crazy?"
                                                                                        },
                                                                                        "id": "continue_1792419247667",
                                                                                        "text": ""
                                                                                      }
                                                                                    ],
                                                                                    "id": "node_1792418911126",
                                                                                    "speaker": "Billie",
                                                                                    "text": "Mr. Boring here thinks that I harassed Tim out of the school. Ugh, un-freaking-believable. I just made some jokes, not send him death threats!"
                                                                                  },
                                                                                  "id": "continue_1792418911126",
                                                                                  "text": ""
                                                                                }
                                                                              ],
                                                                              "id": "node_1792418734682",
                                                                              "speaker": "Stan",
                                                                              "text": "Yes, you have! You made this school unbearable with your so-called “humour” for him. Now you're doing the same to Vic. \n"
                                                                            },
                                                                            "id": "continue_1792418734682",
                                                                            "text": ""
                                                                          }
                                                                        ],
                                                                        "id": "node_1792418641250",
                                                                        "speaker": "Billie",
                                                                        "text": "I have nothing to do with that! He chose to do it. I can't be responsible for what he chooses!"
                                                                      },
                                                                      "id": "continue_1792418641250",
                                                                      "text": ""
                                                                    }
                                                                  ],
                                                                  "id": "node_1792418602039",
                                                                  "speaker": "Stan",
                                                                  "text": "Your jokes are only funny to you!  Tim was always the butt of the joke. To the point that he had to change schools!\n"
                                                                },
                                                                "id": "continue_1792418602039",
                                                                "text": ""
                                                              }
                                                            ],
                                                            "id": "node_1792418457997",
                                                            "speaker": "Billie",
                                                            "text": "What do you even mean?"
                                                          },
                                                          "id": "continue_1792418457997",
                                                          "text": ""
                                                        }
                                                      ],
                                                      "id": "node_1792418410709",
                                                      "speaker": "Stan",
                                                      "text": "See what you're doing?"
                                                    },
                                                    "id": "continue_1792418410709",
                                                    "text": ""
                                                  }
                                                ],
                                                "id": "node_1792418253218",
                                                "speaker": "Billie",
                                                "text": "See what?\n"
                                              },
                                              "id": "continue_1792418253218",
                                              "text": ""
                                            }
                                          ],
                                          "id": "node_1792416510252",
                                          "speaker": "Stan",
                                          "text": "Did he also have no sense of humour?\nYou don't see it do you?"
                                        },
                                        "id": "continue_1792416510252",
                                        "text": ""
                                      }
                                    ],
                                    "id": "node_1792416470801",
                                    "speaker": "Billie",
                                    "text": "What about him?"
                                  },
                                  "id": "continue_1792416470801",
                                  "text": ""
                                }
                              ],
                              "id": "node_1792416453191",
                              "speaker": "Stan",
                              "text": "What about Tim?"
                            },
                            "id": "continue_1792416453191",
                            "text": ""
                          }
                        ],
                        "id": "node_1792416413184",
                        "speaker": "Billie",
                        "text": "It's not my problem if Vic  has no sense of humour either! They can benefit from relaxing a bit more."
                      },
                      "id": "continue_1792416413184",
                      "text": ""
                    }
                  ],
                  "id": "node_1792416376515",
                  "speaker": "Stan",
                  "text": "Are you though? I don't see Vic laughing?"
                },
                "id": "continue_1792416376515",
                "text": ""
              }
            ],
            "id": "node_1792415986124",
            "speaker": "Billie",
            "text": "What the hell! Have you have lost your sense of humour? I'm just joking here."
          },
          "id": "continue_1792415986124",
          "text": ""
        }
      ],
      "emotion": "neutral",
      "id": "root",
      "speaker": "Stan",
      "text": "-You know what, that's enough Billie!"
    },
