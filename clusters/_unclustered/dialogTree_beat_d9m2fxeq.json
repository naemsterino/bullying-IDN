                                                                                                                  "choices": [
                                                                                                                    {
                                                                                                                      "dialogNode": {
                                                                                                                        "characterRef": "char_1792094383279_wzb17mkkt",
                                                                                                                        "choices": [
                                                                                                                          {
                                                                                                                            "dialogNode": {
                                                                                                                              "characterRef": "char_1792095472673_hlp3ie1dh",
                                                                                                                              "choices": [
                                                                                                                                {
                                                                                                                                  "id": "choice_1792770242189",
                                                                                                                                  "target": "beat_m7cn984b",
                                                                                                                                  "text": "...",
                                                                                                                                  "visible": true
                                                                                                                                }
                                                                                                                              ],
                                                                                                                              "id": "node_1792770209012",
                                                                                                                              "speaker": "Billie",
                                                                                                                              "speakerState": "state_1792594346878",
                                                                                                                              "text": "Whatever dude.\""
                                                                                                                            },
                                                                                                                            "id": "choice_1792590956957",
                                                                                                                            "text": "...",
                                                                                                                            "visible": true
                                                                                                                          }
                                                                                                                        ],
                                                                                                                        "id": "node_1792590876197",
                                                                                                                        "speaker": "Stan",
                                                                                                                        "speakerState": "state_1792515162720",
                                                                                                                        "text": "\"Billie, your apology doesn't matter if you continue to behave the same way, and worst of all, on the very same day. Then it's not a real apology!\""
                                                                                                                      },
                                                                                                                      "id": "choice_1792590728860",
                                                                                                                      "text": "...",
                                                                                                                      "visible": true
                                                                                                                    }
                                                                                                                  ],
                                                                                                                  "id": "node_1792590677955",
                                                                                                                  "speaker": "Billie",
                                                                                                                  "speakerState": "state_1792594329217",
                                                                                                                  "text": "\"FOR WHAT??! I literally already apologized to them earlier. I told them I didn't mean to! Why should I apologize again!?\""
                                                                                                                },
                                                                                                                "id": "choice_1792590663208",
                                                                                                                "text": "...",
                                                                                                                "visible": true
                                                                                                              }
                                                                                                            ],
                                                                                                            "id": "node_1792590641430",
                                                                                                            "speaker": "Stan",
                                                                                                            "speakerState": "state_1792515162720",
                                                                                                            "text": "\"Instead of projecting, maybe you can start by apologizing to Vic!\"\n"
                                                                                                          },
                                                                                                          "id": "choice_1792590630656",
                                                                                                          "text": "...",
                                                                                                          "visible": true
                                                                                                        }
                                                                                                      ],
                                                                                                      "id": "node_1792590553929",
                                                                                                      "speaker": "Billie",
                                                                                                      "speakerState": "state_1792594329217",
                                                                                                      "text": "\"WHAT DO YOU WANT FROM ME?! THIS ALWAYS HAPPENS, I'M ALWAYS BEING BLAMED FOR EVERYTHING!!! UGGHH, I JUST WANNA HAVE A NICE DAY HAVING FUN WITH MY FRIENDS IN PEACE. JUST LEAVE ME ALONE!\"\n"
                                                                                                    },
                                                                                                    "id": "choice_1792590068347",
                                                                                                    "text": "...",
                                                                                                    "visible": true
                                                                                                  }
                                                                                                ],
                                                                                                "id": "node_1792589875499",
                                                                                                "speaker": "Stan",
                                                                                                "speakerState": "state_1792515115890",
                                                                                                "text": "\"Real classy Billie! Now I'm Mr. Boring, aren't I? Also bringing up unhinged death threats. Are you crazy!?\"\n"
                                                                                              },
                                                                                              "id": "choice_1792589862019",
                                                                                              "text": "...",
                                                                                              "visible": true
                                                                                            }
                                                                                          ],
                                                                                          "id": "node_1792589788367",
                                                                                          "speaker": "Neo, Cece, Pete",
                                                                                          "text": "\"Dude-\""
                                                                                        },
                                                                                        "id": "choice_1792589761117",
                                                                                        "text": "\"...??!\"",
                                                                                        "visible": true
                                                                                      }
                                                                                    ],
                                                                                    "id": "node_1792589686654",
                                                                                    "speaker": "Billie",
                                                                                    "speakerState": "state_1792594346878",
                                                                                    "text": "\"Mr. Boring here thinks that I harassed Tim out of the school. Ugh, un-freaking-believable. I just made some jokes, it's not like I sent him death threats!\"\n"
                                                                                  },
                                                                                  "id": "choice_1792589677232",
                                                                                  "text": "...",
                                                                                  "visible": true
                                                                                }
                                                                              ],
                                                                              "id": "node_1792589613504",
                                                                              "speaker": "Stan",
                                                                              "speakerState": "state_1792515115890",
                                                                              "text": "\"Yes, you have! You made school unbearable for him with your so-called “humour”. Now you're doing the same thing to Vic!\"\n"
                                                                            },
                                                                            "id": "choice_1792586297805",
                                                                            "text": "...",
                                                                            "visible": true
                                                                          }
                                                                        ],
                                                                        "id": "node_1792586163162",
                                                                        "speaker": "Billie",
                                                                        "speakerState": "state_1792594346878",
                                                                        "text": "\"Oh COME ON. I have nothing to do with that. That was HIS choice. I can't be responsible for what HE chooses.\"\n"
                                                                      },
                                                                      "id": "choice_1792585150768",
                                                                      "text": "...",
                                                                      "visible": true
                                                                    }
                                                                  ],
                                                                  "id": "node_1792585091653",
                                                                  "speaker": "Stan",
                                                                  "speakerState": "state_1792517853756",
                                                                  "text": "\"Your jokes are only funny to you, and Tim was always the butt of the joke. To the point that he had to change schools.\""
                                                                },
                                                                "id": "choice_1792584716847",
                                                                "text": "...",
                                                                "visible": true
                                                              }
                                                            ],
                                                            "id": "node_1792584696576",
                                                            "speaker": "Billie",
                                                            "speakerState": "state_1792594346878",
                                                            "text": "\"What do you mean?\"\n"
                                                          },
                                                          "id": "choice_1792584664922",
                                                          "text": "...",
                                                          "visible": true
                                                        }
                                                      ],
                                                      "id": "node_1792584566461",
                                                      "speaker": "Stan",
                                                      "speakerState": "state_1792517853756",
                                                      "text": "\"See what you're doing?\""
                                                    },
                                                    "id": "choice_1792584560113",
                                                    "text": "...",
                                                    "visible": true
                                                  }
                                                ],
                                                "id": "node_1792584509952",
                                                "speaker": "Billie",
                                                "speakerState": "state_1792594346878",
                                                "text": "\"See what?\""
                                              },
                                              "id": "choice_1792584501130",
                                              "text": "...",
                                              "visible": true
                                            }
                                          ],
                                          "id": "node_1792584441063",
                                          "speaker": "Stan",
                                          "speakerState": "state_1792515162720",
                                          "text": "\"Did he also have no sense of humour?\nYou don't see it do you?\""
                                        },
                                        "id": "choice_1792584391144",
                                        "text": "...",
                                        "visible": true
                                      }
                                    ],
                                    "id": "node_1792583990714",
                                    "speaker": "Billie",
                                    "speakerState": "state_1792594329217",
                                    "text": "\"What about him?\""
                                  },
                                  "id": "choice_1792583983316",
                                  "text": "...",
                                  "visible": true
                                }
                              ],
                              "id": "node_1792583747959",
                              "speaker": "Stan",
                              "speakerState": "state_1792515115890",
                              "text": "\"What about Tim?\""
                            },
                            "id": "choice_1792583707881",
                            "text": "...",
                            "visible": true
                          }
                        ],
                        "id": "node_1792583673931",
                        "speaker": "Billie",
                        "speakerState": "state_1792594346878",
                        "text": " \"It's not my problem if Vic has no sense of humour!\""
                      },
                      "id": "choice_1792583666144",
                      "text": "...",
                      "visible": true
                    }
                  ],
                  "id": "node_1792583629221",
                  "speaker": "Stan",
                  "speakerState": "state_1792515162720",
                  "text": "\"Are you though? I don't see Vic laughing?\"\n"
                },
                "id": "choice_1792583417844",
                "text": "...",
                "visible": true
              }
            ],
            "id": "node_1792583108615",
            "speaker": "Billie",
            "speakerState": "state_1792594329217",
            "text": "\"What the hell!? Have you lost your sense of humour? I'm just joking here!\""
          },
          "id": "choice_1792583030324",
          "text": "...?!",
          "visible": true
        }
      ],
      "emotion": "neutral",
      "id": "root",
      "speaker": "Stan",
      "speakerState": "state_1792515115890",
      "text": "\"You know what, that's enough Billie!\""
    },
